# =============================================================================
# Mergington High School API - Environment Configuration Template
# Copy this file to .env and fill in your values
# =============================================================================

# --- Application ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-in-production

# --- Database ---
MONGODB_URL=mongodb://localhost:27017/
DATABASE_NAME=mergington_high

# --- Redis Cache ---
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Security ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Logging ---
LOG_LEVEL=INFO
FILE_LOG_LEVEL=DEBUG

# --- Teacher Passwords (REQUIRED in production) ---
TEACHER_PASSWORD_MRODRIGUEZ=change-me
TEACHER_PASSWORD_MCHEN=change-me
TEACHER_PASSWORD_PRINCIPAL=change-me
